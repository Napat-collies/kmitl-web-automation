# Copy this file to `.env` (in this backend/ folder) and fill in your keys.
#   cp .env.example .env

# --- Web search: free dev key from https://tavily.com (sign up -> API key) ---
TAVILY_API_KEY=tvly-...

# --- LLM: your personal course key from the portal (Profile -> API key) ---
LLM_API_KEY=sk-...

# Defaults below are fine for the class proxy — only change if you know why.
LLM_BASE_URL=https://llm.nat-d.uk/v1
MODEL=gemma-4-E4B-it
